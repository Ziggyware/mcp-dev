{
  "name": "mcp-dev",
  "version": "0.2.0",
  "description": "Fast, approval-first CLI for registered MCP servers",
  "type": "module",
  "bin": {
    "mcp-dev": "./src/index.js"
  },
  "files": [
    "src",
    "scripts",
    "examples",
    "README.md",
    "inst_pwsh.ps1"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test",
    "check": "node ./scripts/check.mjs",
    "smoke": "node ./src/index.js --help && node ./src/index.js completion bash > /dev/null"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@inquirer/core": "^10.3.2",
    "@inquirer/prompts": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "zod": "^4.4.3"
  }
}
